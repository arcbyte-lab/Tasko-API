{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasko-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tasko",
      // Placeholder until `wrangler d1 create tasko` is run for the real account.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
